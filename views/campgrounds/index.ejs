<% layout('layouts/boilerplate') %>

    <h1>All Campgrounds</h1>
    <h2><a href="/campgrounds/new">Add New Campground</a></h2>
   
<% for (let campground of campgrounds) { %>
    <div class="card" mb-3>
        <div class="row">
            <div class="col-md-4">
                <img class="image-fluid" src="<%= campground.image %>" alt="<%= campground.image %>">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title"> <%= campground.title %></h5>
                    <p class="card-text"><%= campground.description %></p>
                    
                    <p class="card-text"><strong>Price:</strong> $<%= campground.price %></p>
                    <p class="card-text"><small class="text-muted"><%= campground.location %></small> </p>
                    <p class="card-text">
                        <small class="text-muted">
                            <a class="btn btn-outline-secondary" href="/campgrounds/<%= campground._id %>">View Campground</a>
                        </small>
                    </p>
                </div>
                    

            </div>
        </div>
    </div>

<% } %>
  
  

